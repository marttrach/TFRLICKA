TRA_TOKEN_SECRET=replace-with-at-least-32-random-characters
# Optional. When omitted, a Fernet key is generated in TRA_DATA_DIR/fernet.key.
TRA_ENCRYPTION_KEY=
TRA_DATA_DIR=./data
TRA_API_HOST=0.0.0.0
TRA_API_PORT=8000
# Optional comma-separated origins when the frontend calls the API directly.
TRA_CORS_ORIGINS=
TRA_LOG_LEVEL=INFO
# Optional task webhook. Both are required to enable it; leave either empty to
# disable notifications entirely. The URL must be HTTPS unless it is loopback:
# the secret is sent verbatim as the X-TRA-Token header (n8n Header Auth), so
# cleartext to a remote host would leak it.
TRA_WEBHOOK_URL=
TRA_WEBHOOK_SECRET=
# Public dashboard origin used in the notification action link.
TRA_PUBLIC_URL=http://localhost:43124
# MCP endpoint for an AI agent such as Hermes: POST /mcp with
# "Authorization: Bearer <TRA_AGENT_TOKEN>". Leave the token empty to disable.
# The agent acts as the dashboard account registered with TRA_AGENT_EMAIL.
TRA_AGENT_TOKEN=
TRA_AGENT_EMAIL=
# Optional TDX credentials. Without them, the API stays available with the
# built-in popular stations and train-number mode.
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
TDX_CACHE_TTL_HOURS=6
# Docker Hub account CI pushes images to; docker-compose.yml pulls from it.
DOCKERHUB_USER=
