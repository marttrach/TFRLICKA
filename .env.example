TRA_TOKEN_SECRET=replace-with-at-least-32-random-characters
# Optional. When omitted, a Fernet key is generated in TRA_DATA_DIR/fernet.key.
TRA_ENCRYPTION_KEY=
TRA_DATA_DIR=./data
TRA_API_HOST=0.0.0.0
TRA_API_PORT=8000
# Optional comma-separated origins when the frontend calls the API directly.
TRA_CORS_ORIGINS=
TRA_LOG_LEVEL=INFO
# Optional task-ready webhook. Both URL and secret are required to enable it.
TRA_WEBHOOK_URL=
TRA_WEBHOOK_SECRET=
# Optional static header (X-TRA-Auth) for receivers that cannot verify the
# HMAC signature, such as an n8n instance that blocks $env in Code nodes.
# Use a DIFFERENT value from TRA_WEBHOOK_SECRET: this one is sent in cleartext.
TRA_WEBHOOK_AUTH_TOKEN=
# Public dashboard origin used in the notification action link.
TRA_PUBLIC_URL=http://localhost:43124
# Verification adapter: manual (production), mock (localhost tests), or
# official_api (reserved until TRC publishes an approved integration).
TRA_VERIFICATION_PROVIDER=manual
# Used only by the localhost-only mock adapter.
TRA_MOCK_VERIFICATION_TOKEN=
# Remote booking hand-off. Points at the browser sidecar's CDP endpoint.
# Leave empty to launch a browser locally instead (CLI on your own machine).
# Never publish this port: CDP has no authentication.
TRA_BROWSER_CDP_URL=http://tra-sniper-browser:9222
# Optional TDX credentials. Without them, the API stays available with the
# built-in popular stations and train-number mode.
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
TDX_CACHE_TTL_HOURS=6
